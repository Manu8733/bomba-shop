---
// Liquid: layout/theme.liquid. Every page renders inside this layout.
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/figtree';
import '../styles/base.css';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';
import CartDrawer from '../sections/CartDrawer.astro';
import RouteGate from '../sections/RouteGate.astro';
import Toast from '../snippets/Toast.astro';
import { modeBootScript } from '../scripts/mode';
import { introBootScript } from '../scripts/intro';
import { shop } from '../config';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** pages that must work before the gate is answered (legal pages, 404) */
  skipGate?: boolean;
  current?: string;
}
const { title, description, image = '/brand/og-image.png', canonical, noindex = false, jsonLd, skipGate = false, current } = Astro.props;
const site = Astro.site!;
const url = new URL(canonical ?? Astro.url.pathname, site).href;
const fullTitle = title.includes('Bomba') ? title : `${title} · Bomba Shop`;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: shop.name, legalName: shop.company.legalName,
  url: site.href, logo: new URL('/brand/icon-512.png', site).href, email: shop.email.office,
  taxID: shop.company.cui,
};
const ld = [org, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="ro" data-mode="unset">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#07060b" />
  <meta name="color-scheme" content="dark" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ro_RO" />
  <meta property="og:site_name" content={shop.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={new URL(image, site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline set:html={modeBootScript} />
  <script is:inline set:html={introBootScript} />
  <style is:inline>
    /* entry intro (scripts/intro.ts): cover the first paint, hide the header logo until the sparks land on it */
    html.intro:not(.intro-live) body::after { content: ''; position: fixed; inset: 0; z-index: 95; background: #07060b; pointer-events: none; }
    html.intro .site-header .brand svg { opacity: 0; }
    html.intro-land .site-header .brand svg { opacity: 1; transition: opacity .35s ease-out; filter: drop-shadow(0 0 14px rgba(255, 182, 72, .55)); }
    .intro-canvas { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 96; cursor: pointer; }
  </style>
  {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Sari la conținut</a>
  <Header current={current} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <CartDrawer />
  {!skipGate && <RouteGate />}
  <Toast />
  <script>
    import { initCartButtons, refreshCart } from '../scripts/cart';
    import { runIntro } from '../scripts/intro';
    runIntro();
    initCartButtons();
    refreshCart();
  </script>
</body>
</html>
