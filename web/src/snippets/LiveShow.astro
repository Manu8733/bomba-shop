---
// A small live show (Liquid: snippets/live-show.liquid + assets/hero-stage.js): aerial shells fired from a row of tubes
// on the ground, breaking into peonies, rings and gold willows, drawn by the same engine as the hero stage.
// Decorative; starts when it comes near the screen and pauses off it. Used behind the home "Spectacole" section and as the banner of /pages/spectacole.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={['live-show', cls]} aria-hidden="true" data-live-show>
  <canvas data-live-canvas></canvas>
  <span class="line" data-live-line></span>
</div>
<style>
  .live-show { position: relative; isolation: isolate; overflow: hidden; background: linear-gradient(180deg, #07060b 0%, #0b0911 70%, #13101a 100%); }
  /* the ground the tubes stand on */
  .live-show::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 14%; z-index: -2;
    background: linear-gradient(180deg, #16121e, #0c0a12 60%, #07060b); box-shadow: 0 -1px 0 rgba(246, 241, 234, .05); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  /* the firing line: invisible, it only tells the engine where the tubes stand */
  .line { position: absolute; left: var(--from, 6%); right: var(--to, 6%); bottom: 14%; height: 2px; pointer-events: none; }
</style>
<script>
  import type { Shot } from '../scripts/stage';
  const nozzles = [[.04, 1], [.52, 1], [.22, 1], [.78, 1], [.38, 1], [.96, 1], [.64, 1], [.12, 1]];
  document.querySelectorAll<HTMLElement>('[data-live-show]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-live-canvas]')!, line = root.querySelector<HTMLElement>('[data-live-line]')!;
    if (!('IntersectionObserver' in window)) return;
    const near = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      near.disconnect();
      import('../scripts/stage').then(({ startStage }) => {
        const shot: Shot = { effect: 'show', color: 'gold', obj: [0, 0, 1, 1], el: line, nozzles };
        startStage(canvas, root).fire(shot);
      }).catch(() => { /* decorative only */ });
    }, { rootMargin: '300px 0px' });
    near.observe(root);
  });
</script>
