---
// Polite live region for short messages. Any script: window.dispatchEvent(new CustomEvent('toast', {detail:{message, tone}})).
---
<div class="toasts" aria-live="polite" aria-atomic="true" data-toasts></div>
<style>
  .toasts { position: fixed; z-index: var(--z-toast); left: 50%; transform: translateX(-50%);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 20px); display: flex; flex-direction: column; gap: 8px; width: min(440px, calc(100% - 32px)); pointer-events: none; }
  .toasts :global(.toast) { pointer-events: auto; background: var(--night-800); border: 1px solid var(--night-600); border-left: 3px solid var(--magnesium-400);
    color: var(--white); padding: 12px 16px; border-radius: var(--radius-label); font-size: var(--text-sm); box-shadow: 0 12px 32px rgba(0, 0, 0, .5);
    animation: in var(--dur-reveal) var(--ease-out-expo); }
  .toasts :global(.toast.warn) { border-left-color: var(--strontium-500); }
  @keyframes in { from { opacity: 0; transform: translateY(12px); } }
</style>
<script>
  const box = document.querySelector('[data-toasts]')!;
  window.addEventListener('toast', (e) => {
    const { message, tone } = (e as CustomEvent).detail as { message: string; tone?: string };
    const t = document.createElement('div');
    t.className = `toast ${tone ?? ''}`;
    t.textContent = message;
    box.appendChild(t);
    setTimeout(() => t.remove(), 4200);
  });
</script>
