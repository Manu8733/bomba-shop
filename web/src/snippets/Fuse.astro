---
// The fuse: a progress bar that burns left to right, spark at the tip (DESIGN.md §5).
// Client code can update it by setting the --p custom property (0..1) on the element.
interface Props { value?: number; label?: string; class?: string; id?: string }
const { value = 0, label, class: cls, id } = Astro.props;
---
<div class:list={['fuse', cls]} id={id} style={`--p:${Math.max(0, Math.min(1, value))}`} role="progressbar"
  aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(value * 100)} aria-label={label}>
  <span class="burn"></span>
</div>
<style>
  .fuse { --p: 0; height: 6px; background: var(--night-700); border-radius: 3px; position: relative; }
  .burn { position: absolute; inset: 0 auto 0 0; width: calc(var(--p) * 100%); border-radius: 3px;
    background: linear-gradient(90deg, #ff6a13, var(--fx-sodium)); transition: width var(--dur-scene) var(--ease-out-expo); }
  .burn::after { content: ''; position: absolute; right: -6px; top: 50%; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%;
    background: #fff3c4; box-shadow: 0 0 14px 5px rgba(255, 182, 72, .75); animation: flicker 1.2s steps(3) infinite; }
  @keyframes flicker { 50% { box-shadow: 0 0 8px 3px rgba(255, 182, 72, .5); } }
</style>
