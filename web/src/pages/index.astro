---
// Liquid: templates/index.json → home-hero, home-shelf, featured-collection, home-promise.
import Theme from '../layouts/Theme.astro';
import Hero from '../sections/home/Hero.astro';
import Shelf from '../sections/home/Shelf.astro';
import InStock from '../sections/home/InStock.astro';
import Promise from '../sections/home/Promise.astro';
const site = Astro.site!;
const ld = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'Bomba Shop', url: site.href, inLanguage: 'ro',
  potentialAction: { '@type': 'SearchAction', target: `${site.href}search?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---
<Theme title="Bomba Shop · Artificii și petarde" current="home" jsonLd={ld}
  description="Artificii F1 pentru public, artificii de tort, vulcani, bengale și fum colorat, cu categoria și datele tehnice la vedere.">
  <Hero />
  <Shelf />
  <InStock />
  <Promise />
</Theme>
