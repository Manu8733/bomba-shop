---
// Liquid: templates/page.contact.json with {% form 'contact' %}: contact[comanda], contact[subiect], contact[email],
// contact[name], contact[body]. The page answers one thing: questions about an order already placed.
import Theme from '../../layouts/Theme.astro';
import ContentHero from '../../sections/ContentHero.astro';
import Icon from '../../snippets/Icon.astro';
import { shop, commerce } from '../../config';
const topics = [
  { id: 'stare', label: 'Unde e comanda mea', hint: 'Scrie-ne numărul comenzii și verificăm unde e coletul.' },
  { id: 'modific', label: 'Vreau să modific sau să anulez', hint: 'Spune-ne ce vrei să schimbi: produsele, adresa de livrare sau plata.' },
  { id: 'retur', label: 'Retur sau produs cu probleme', hint: `Ai ${commerce.returns.days} zile de la primire ca să renunți la produsele nefolosite, în ambalajul original.` },
  { id: 'altceva', label: 'Altceva despre comandă', hint: '' },
];
const phone = shop.phone.value;
---
<Theme title="Contact" description="Întrebări despre o comandă Bomba Shop: unde e coletul, modificare, anulare sau retur." skipGate>
  <ContentHero title="Contact" lede="Ai o întrebare despre o comandă? Scrie numărul ei și ce s-a întâmplat. Răspundem pe email." />
  <div class="container section layout">
    <form class="form" data-contact novalidate aria-label="Întrebare despre comandă">
      <div class="grid" data-fields>
        <fieldset class="topics span">
          <legend>Despre ce e vorba?</legend>
          <div class="opts">
            {topics.map((t, i) => (
              <label class="opt"><input type="radio" name="subiect" value={t.id} id={`ct-t${i}`} checked={i === 0} data-hint={t.hint} /><span>{t.label}</span></label>
            ))}
          </div>
          <p class="hint" data-topic-hint aria-live="polite">{topics[0].hint}</p>
        </fieldset>
        <div class="field"><label for="ct-order">Numărul comenzii</label>
          <input class="input" id="ct-order" list="ct-orders" inputmode="numeric" pattern="^#?[0-9]{3,8}$" required placeholder="ex. 1024"
            data-msg="Scrie numărul comenzii, doar cifre (ex. 1024)." aria-describedby="ct-order-hint" />
          <datalist id="ct-orders" data-orders></datalist>
          <p class="hint" id="ct-order-hint">E în emailul de confirmare, la subiect.</p></div>
        <div class="field"><label for="ct-email">Emailul folosit la comandă</label>
          <input class="input" id="ct-email" type="email" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" /></div>
        <div class="field span"><label for="ct-name">Nume</label><input class="input" id="ct-name" required autocomplete="name" data-msg="Scrie-ți numele." /></div>
        <div class="field span"><label for="ct-msg">Mesaj</label>
          <textarea class="input" id="ct-msg" required rows="6" data-msg="Scrie pe scurt ce s-a întâmplat."></textarea></div>
        <label class="check span"><input type="checkbox" id="ct-consent" required data-msg="Bifează acordul ca să-ți putem răspunde." />
          <span>Sunt de acord să folosiți aceste date ca să-mi răspundeți. <a href="/pages/confidentialitate">Confidențialitate</a></span></label>
        <div class="span"><button class="btn btn-primary" type="submit">Trimite întrebarea <Icon name="arrow" size={18} /></button></div>
      </div>
      <div class="done" data-done hidden tabindex="-1">
        <h2>Mesajul e gata</h2>
        <p data-done-text></p>
        <a class="btn btn-primary" data-mail href={`mailto:${shop.email.orders}`}>Trimite-l pe email</a>
      </div>
      <p class="demo">Demonstrativ: până la lansare formularul nu trimite nimic. Butonul de la final deschide mesajul în aplicația ta de email.</p>
    </form>
    <aside class="info">
      <section>
        <h2>Direct pe email</h2>
        <a href={`mailto:${shop.email.orders}`}>{shop.email.orders}</a>
        <p>Pune numărul comenzii la subiect.</p>
      </section>
      {phone && <section><h2>Telefon</h2><a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a></section>}
      <section>
        <h2>Poate găsești deja răspunsul</h2>
        <ul role="list">
          <li><a href="/pages/livrare-retur">Livrare și retur</a></li>
          <li><a href="/pages/faq">Întrebări frecvente</a></li>
          <li><a href="/account">Comenzile din contul tău</a></li>
        </ul>
      </section>
    </aside>
  </div>
</Theme>
<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-16); padding-top: var(--space-4); }
  @media (min-width: 1024px) { .layout { grid-template-columns: minmax(0, 46rem) minmax(240px, 320px); justify-content: space-between; padding-top: var(--space-8); } }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6) var(--space-4); }
  @media (min-width: 768px) { .grid { grid-template-columns: 1fr 1fr; } .span { grid-column: 1 / -1; } }
  .topics { margin: 0; padding: 0; border: 0; display: grid; gap: var(--space-3); }
  .topics legend { margin-bottom: var(--space-3); padding: 0; font-weight: 600; color: var(--white); }
  .opts { display: grid; gap: var(--space-2); }
  @media (min-width: 560px) { .opts { grid-template-columns: 1fr 1fr; } }
  .opt { position: relative; display: flex; align-items: center; min-height: 56px; padding: 12px 16px 12px 44px; border: var(--border); border-radius: var(--radius-card);
    background: var(--night-900); color: var(--smoke-200); font-weight: 600; cursor: pointer; transition: border-color var(--dur-ui), color var(--dur-ui); }
  .opt:hover { color: var(--white); border-color: var(--night-600); }
  .opt input { position: absolute; left: 16px; top: 50%; width: 18px; height: 18px; margin: -9px 0 0; accent-color: var(--magnesium-400); }
  .opt:has(:checked) { color: var(--white); border-color: var(--magnesium-400); }
  .opt:has(:focus-visible) { outline: 2px solid var(--magnesium-400); outline-offset: 2px; }
  .hint { font-size: var(--text-sm); color: var(--smoke-400); }
  .hint:empty { display: none; }
  textarea.input { min-height: 9rem; resize: vertical; }
  .check { display: flex; gap: 10px; align-items: center; min-height: 44px; font-size: var(--text-sm); color: var(--smoke-200); }
  .check input { width: 20px; height: 20px; margin-top: 1px; accent-color: var(--magnesium-400); flex: none; }
  .check a { color: var(--white); }
  .form :global(.err) { color: var(--danger); font-size: var(--text-sm); }
  .form :global(.input[aria-invalid='true']) { border-color: var(--danger); }
  .done { display: grid; gap: var(--space-3); padding-left: var(--space-4); border-left: 2px solid var(--ok); }
  .done:focus { outline: none; }
  .done h2 { font-size: var(--text-3xl); }
  .done { justify-items: start; }
  .done p { max-width: 52ch; color: var(--smoke-200); }
  .demo { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--smoke-400); }
  .info { display: grid; gap: var(--space-8); align-content: start; }
  .info section { display: grid; gap: var(--space-2); justify-items: start; padding-top: var(--space-6); border-top: var(--border); }
  .info section:first-child { padding-top: 0; border-top: 0; }
  .info h2 { font: 600 var(--text-sm)/1.3 var(--font-body); color: var(--smoke-400); text-transform: none; letter-spacing: 0; }
  .info p { font-size: var(--text-sm); color: var(--smoke-400); }
  .info ul { margin: 0; padding: 0; list-style: none; }
  .info a { display: inline-flex; align-items: center; min-height: 44px; color: var(--white); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .info a:hover { color: var(--magnesium-400); }
</style>
<script>
  import { getAccount, getOrders } from '../../scripts/account';
  import { validate } from '../../scripts/auth-forms';
  const form = document.querySelector<HTMLFormElement>('[data-contact]')!;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const MAIL = new URL(document.querySelector<HTMLAnchorElement>('[data-mail]')!.href).pathname;
  // prefill from the order page (?comanda=) and from the signed-in account
  const acc = getAccount(), q = new URLSearchParams(location.search).get('comanda');
  if (q) $('ct-order').value = q;
  if (acc) { $('ct-email').value = acc.email; $('ct-name').value = [acc.firstName, acc.lastName].filter(Boolean).join(' '); }
  document.querySelector('[data-orders]')!.replaceChildren(...getOrders().map((o) => Object.assign(document.createElement('option'), { value: String(o.number) })));
  const hint = document.querySelector<HTMLElement>('[data-topic-hint]')!;
  form.querySelectorAll<HTMLInputElement>('input[name="subiect"]').forEach((r) => r.addEventListener('change', () => { hint.textContent = r.dataset.hint ?? ''; }));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    $('ct-order').value = $('ct-order').value.trim(); $('ct-email').value = $('ct-email').value.trim();
    if (!validate(form)) return;
    // until the port nothing is posted: the message is handed to the customer's own email app, ready to send
    const n = $('ct-order').value.replace('#', ''), topic = form.querySelector<HTMLInputElement>('input[name="subiect"]:checked')!;
    const subject = `Comanda #${n}: ${topic.nextElementSibling!.textContent}`;
    const body = `${$('ct-msg').value.trim()}\n\n${$('ct-name').value.trim()}\n${$('ct-email').value}`;
    document.querySelector<HTMLAnchorElement>('[data-mail]')!.href = `mailto:${MAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    document.querySelector('[data-done-text]')!.textContent = `Despre comanda #${n}. Îl trimiți din aplicația de email, iar răspunsul vine la ${$('ct-email').value}.`;
    form.querySelector<HTMLElement>('[data-fields]')!.hidden = true;
    const done = form.querySelector<HTMLElement>('[data-done]')!; done.hidden = false; done.focus();
  });
</script>
