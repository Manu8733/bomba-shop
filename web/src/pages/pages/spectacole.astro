---
// Liquid: templates/page.spectacole.json. Copy from the shop's services page; image is an AI illustration.
import Theme from '../../layouts/Theme.astro';
import ContentHero from '../../sections/ContentHero.astro';
import { shop } from '../../config';
const events = ['Nuntă', 'Botez', 'Petrecere privată', 'Eveniment corporate', 'Festival', 'Concert', 'Inaugurare', 'Altul'];
const offer = ['Artificii de exterior, de seară și de noapte', 'Artificii de zi cu efecte colorate', 'Artificii de interior', 'Moriști rotitoare și cascade pirotehnice', 'Scris pirotehnic', 'Jerbe, vulcani și efecte speciale'];
---
<Theme title="Spectacole pirotehnice" current="spectacole" description="Show-uri de artificii personalizate pentru nunți, botezuri, evenimente corporate, festivaluri și inaugurări. Cere o ofertă.">
  <ContentHero title="Spectacole pirotehnice" lede="Show-uri de artificii pentru nunți, botezuri, evenimente corporate și festivaluri, gândite după locație și buget.">
    <a class="btn btn-primary" href="#oferta">Cere o ofertă</a>
  </ContentHero>
  <section class="container band first">
    <img class="hero-img" src="/images/fx/show-lake-1600.webp" srcset="/images/fx/show-lake-800.webp 800w, /images/fx/show-lake-1600.webp 1600w" sizes="(min-width: 1200px) 1200px, 100vw" width="1600" height="900" alt="Imagine ilustrativă: spectacol de artificii deasupra unui lac" loading="eager" />
    <div class="two">
      <div class="prose">
        <h2>Ce facem</h2>
        <p>Facem spectacole pirotehnice pentru nunți, botezuri, petreceri private, evenimente corporate, festivaluri, concerte și inaugurări.</p>
        <p>Fiecare spectacol îl gândim după locație, atmosferă, tematică și buget. Lucrăm cu echipamente și produse pirotehnice autorizate.</p>
      </div>
      <div>
        <h3 class="offer-h">Ce oferim</h3>
        <ul class="offer">{offer.map((o) => <li>{o}</li>)}</ul>
      </div>
    </div>
  </section>
  <section class="container band quote-band" id="oferta" aria-labelledby="quote-h">
    <div class="quote-intro">
      <h2 id="quote-h">Cere o ofertă</h2>
      <p>Spune-ne ce eveniment ai, unde și când. Îți răspundem pe email.</p>
    </div>
    <form class="quote" data-demo-form novalidate>
      <div data-fields class="grid">
        <div class="field"><label for="q-type">Tip eveniment</label><select class="input" id="q-type" required><option value="">Alege</option>{events.map((e) => <option>{e}</option>)}</select><p class="err" data-err-for="q-type" hidden>Alege tipul evenimentului.</p></div>
        <div class="field"><label for="q-date">Data</label><input class="input" id="q-date" type="date" required /><p class="err" data-err-for="q-date" hidden>Alege data.</p></div>
        <div class="field"><label for="q-place">Localitate</label><input class="input" id="q-place" required autocomplete="address-level2" /><p class="err" data-err-for="q-place" hidden>Scrie localitatea.</p></div>
        <div class="field"><label for="q-guests">Număr de invitați (aprox.)</label><input class="input" id="q-guests" type="number" min="1" inputmode="numeric" /></div>
        <div class="field"><label for="q-budget">Buget orientativ</label><select class="input" id="q-budget"><option value="">Prefer să discutăm</option><option>sub 2.000 lei</option><option>2.000 – 5.000 lei</option><option>5.000 – 10.000 lei</option><option>peste 10.000 lei</option></select></div>
        <div class="field"><label for="q-name">Nume</label><input class="input" id="q-name" required autocomplete="name" /><p class="err" data-err-for="q-name" hidden>Scrie-ți numele.</p></div>
        <div class="field"><label for="q-email">Email</label><input class="input" id="q-email" type="email" required autocomplete="email" /><p class="err" data-err-for="q-email" hidden>Scrie o adresă de email validă.</p></div>
        <div class="field"><label for="q-phone">Telefon</label><input class="input" id="q-phone" type="tel" autocomplete="tel" /></div>
        <div class="field span"><label for="q-msg">Detalii</label><textarea class="input" id="q-msg" placeholder="Locația, ora, momentul dorit (intrarea mirilor, tortul, finalul serii)…"></textarea></div>
        <label class="check span"><input type="checkbox" id="q-consent" required /> <span>Sunt de acord să fiu contactat pentru această ofertă. <a href="/pages/confidentialitate">Confidențialitate</a></span></label>
        <p class="err span" data-err-for="q-consent" hidden>Bifează acordul ca să-ți putem răspunde.</p>
        <div class="span"><button class="btn btn-primary" type="submit">Trimite cererea</button></div>
      </div>
      <div class="done" data-done hidden tabindex="-1"><h2>Am primit cererea</h2><p>Îți răspundem pe email. Dacă vrei să adaugi ceva, scrie-ne la {shop.email.office}.</p></div>
    </form>
  </section>
</Theme>
<style>
  .band { padding-block: var(--space-12); }
  .band.first { padding-top: 0; }
  .hero-img { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; border-radius: var(--radius-card); }
  @media (max-width: 767px) { .hero-img { aspect-ratio: 4 / 3; } }
  .two { display: grid; gap: var(--space-8); margin-top: var(--space-12); }
  @media (min-width: 1024px) { .two { grid-template-columns: 1.2fr 1fr; gap: var(--space-16); } }
  .prose { max-width: 60ch; }
  .prose h2 { margin-top: 0; font-size: clamp(2rem, 4vw, 3rem); }
  .prose p { margin-top: var(--space-4); color: var(--smoke-200); }
  .offer-h { font: 600 var(--text-sm)/1.3 var(--font-body); text-transform: none; color: var(--smoke-400); }
  .offer { list-style: none; margin: var(--space-3) 0 0; padding: 0; border-top: 2px solid var(--white); }
  .offer li { padding: 14px 0; border-bottom: 1px solid var(--night-700); font-weight: 600; }
  .quote-band { display: grid; gap: var(--space-8); border-top: var(--border); padding-top: var(--space-16); }
  @media (min-width: 1024px) { .quote-band { grid-template-columns: 4fr 8fr; gap: var(--space-16); } }
  .quote-intro h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .quote-intro p { margin-top: var(--space-4); max-width: 40ch; color: var(--smoke-200); }
  .grid { display: grid; gap: var(--space-6) var(--space-4); }
  @media (min-width: 768px) { .grid { grid-template-columns: 1fr 1fr; } .span { grid-column: 1 / -1; } }
  .check { display: flex; gap: 10px; align-items: flex-start; }
  .check input { width: 20px; height: 20px; accent-color: var(--magnesium-400); flex: none; }
  .err { color: var(--danger); font-size: var(--text-sm); }
  .done { display: grid; gap: var(--space-3); padding-left: var(--space-4); border-left: 2px solid var(--ok); }
  .done h2 { font-size: var(--text-3xl); }
  .done p { color: var(--smoke-200); }
</style>
<script>
  import { initDemoForms } from '../../scripts/forms';
  initDemoForms();
</script>
