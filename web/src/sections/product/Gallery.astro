---
// Product gallery. Liquid: media block of sections/main-product.liquid, looping product.media with image_url widths.
// Behaviour: scripts/product.ts → initGallery (thumbnails, keyboard, swipe sync, zoom dialog).
import Img from '../../snippets/Img.astro';
import Icon from '../../snippets/Icon.astro';
import CatBadge from '../../snippets/CatBadge.astro';
import { imagesOf, category, type Product } from '../../lib/catalog';
interface Props { product: Product }
const { product: p } = Astro.props;
const images = imagesOf(p);
const n = images.length;
const many = n > 1;
const sizes = '(min-width: 1440px) 784px, (min-width: 1024px) 55vw, 100vw';
---
<section class="gallery" data-gallery aria-label={`Fotografii: ${p.title}`}>
  <div class="stage mat">
    {n > 0 ? (
      <ul class="track" data-track role="list">
        {images.map((img, i) => {
          const full = img.files.at(-1)!;
          return (
            <li class:list={['slide', img.kind]} data-slide data-full={full.src} data-w={full.w} data-h={full.h}>
              <button type="button" class="open" aria-label={`Mărește imaginea${many ? ` ${i + 1} din ${n}` : ''}: ${img.alt}`}>
                <Img image={img} sizes={sizes} eager={i === 0} />
              </button>
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="slide empty"><Img /></div>
    )}

    {category(p) && <span class="badge" aria-hidden="true"><CatBadge category={category(p)} size="sm" /></span>}

    {many && (
      <>
        <button type="button" class="nav prev" data-prev aria-label="Imaginea anterioară" aria-disabled="true"><Icon name="arrow-left" /></button>
        <button type="button" class="nav next" data-next aria-label="Imaginea următoare"><Icon name="arrow" /></button>
      </>
    )}

    {n > 0 && <span class="hint" aria-hidden="true"><Icon name="search" size={16} />Mărește</span>}
  </div>

  {many && (
    <div class="thumbs" role="group" aria-label="Alege imaginea">
      {images.map((img, i) => (
        <button type="button" class:list={['thumb', img.kind]} data-thumb aria-label={`Imaginea ${i + 1} din ${n}`}
          aria-current={i === 0 ? 'true' : 'false'}>
          <Img image={img} alt="" sizes="80px" />
        </button>
      ))}
    </div>
  )}
  <p class="visually-hidden" aria-live="polite" data-live></p>

  {n > 0 && (
    <dialog class="zoom" data-zoom aria-labelledby="zoom-title">
      <div class="zbar">
        <p class="ztitle" id="zoom-title"><span class="visually-hidden">Imagine mărită: </span>{p.title}</p>
        {many && <span class="zcount" data-zoom-count aria-hidden="true">1 / {n}</span>}
        <div class="ztools">
          <button type="button" class="zbtn" data-zoom-out aria-label="Micșorează" aria-disabled="true"><Icon name="minus" /></button>
          <button type="button" class="zbtn" data-zoom-in aria-label="Mărește"><Icon name="plus" /></button>
          <button type="button" class="zbtn" data-zoom-close aria-label="Închide" autofocus><Icon name="close" /></button>
        </div>
      </div>
      <div class="zview" data-zoom-view>
        <img class="zimg" data-zoom-img alt="" draggable="false" decoding="async" />
      </div>
      {many && (
        <>
          <button type="button" class="znav prev" data-zoom-prev aria-label="Imaginea anterioară"><Icon name="arrow-left" /></button>
          <button type="button" class="znav next" data-zoom-next aria-label="Imaginea următoare"><Icon name="arrow" /></button>
        </>
      )}
      <p class="zhint">Mărește cu + și −, cu rotița sau cu dublu clic. Plimbă cursorul sau degetul peste imagine ca să vezi detaliile.</p>
      <p class="visually-hidden" aria-live="polite" data-zoom-live></p>
    </dialog>
  )}
</section>

<script>
  import { initGallery } from '../../scripts/product';
  initGallery(document.querySelector<HTMLElement>('[data-gallery]'));
</script>

<style>
  .gallery { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }

  /* The night stage: no frame, the sky melts into the page and warm light rises from below. */
  .stage { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-card);
    background: var(--floor); }
  @media (max-width: 767px) { .stage { aspect-ratio: 6 / 5; } }
  @media (min-width: 768px) { .stage { aspect-ratio: 5 / 4; } }
  /* short laptop screens: the photo never runs under the bottom edge */
  @media (min-width: 1024px) { .stage { max-height: calc(100svh - var(--header-h) - 140px); } }
  @media (max-height: 560px) and (orientation: landscape) { .stage { aspect-ratio: auto; height: calc(100svh - var(--header-h) - 72px); } }

  .track { position: relative; display: flex; height: 100%; margin: 0; padding: 0; list-style: none;
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
  .track::-webkit-scrollbar { display: none; }
  .slide { position: relative; flex: 0 0 100%; height: 100%; scroll-snap-align: center; scroll-snap-stop: always; }
  .slide.empty { display: grid; place-items: center; }
  /* the 1fr track keeps tall photos inside the stage instead of letting them grow past it */
  .open { position: relative; z-index: 1; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: end center; width: 100%; height: 100%; padding: 9% 13% 8%;
    border: 0; background: none; cursor: zoom-in; }
  .open:focus-visible { outline-offset: -6px; }
  .open :global(img.pimg) { width: 100%; height: 100%; object-fit: contain; }
  .slide.original .open :global(img.pimg) { border-radius: var(--radius-label); }

  /* on wide screens the buy column shows the large diamond right beside the photo */
  .badge { position: absolute; z-index: 2; top: var(--space-1); left: var(--space-1); pointer-events: none; }
  @media (min-width: 1024px) { .badge { display: none; } }

  .nav { position: absolute; z-index: 2; top: 50%; translate: 0 -50%; display: none; place-items: center; width: 44px; height: 44px;
    border: 0; border-radius: var(--radius-label); color: var(--white);
    background: color-mix(in srgb, var(--night-950) 72%, transparent); transition: color var(--dur-ui), opacity var(--dur-ui); }
  .nav.prev { left: var(--space-3); }
  .nav.next { right: var(--space-3); }
  .nav:hover { color: var(--magnesium-400); }
  .nav[aria-disabled='true'] { opacity: 0; pointer-events: none; }
  @media (min-width: 768px) { .nav { display: grid; } }

  .hint { position: absolute; z-index: 2; right: var(--space-3); bottom: var(--space-3); display: inline-flex; align-items: center; gap: 6px;
    pointer-events: none; font: 500 var(--text-sm)/1 var(--font-body); color: var(--smoke-200); }

  /* thumbnails: the one on stage carries the same 2px magnesium underline as the active tab on the home page */
  .thumbs { display: flex; gap: var(--space-2); overflow-x: auto; padding: 6px 6px 12px; margin: -6px -6px -3px; scrollbar-width: thin; } /* room for the focus ring */
  .thumb { position: relative; flex: none; width: 64px; height: 64px; padding: 4px; border: 0; border-radius: var(--radius-label);
    background: var(--night-900); opacity: .6; transition: opacity var(--dur-ui); }
  @media (min-width: 1024px) { .thumb { width: 80px; height: 80px; } }
  .thumb::after { content: ''; position: absolute; left: 0; right: 0; bottom: -7px; height: 2px; background: transparent; }
  .thumb:hover { opacity: 1; }
  .thumb[aria-current='true'] { opacity: 1; }
  .thumb[aria-current='true']::after { background: var(--magnesium-400); }
  .thumb :global(.pimg) { width: 100%; height: 100%; }
  .thumb.cutout :global(.pimg) { object-fit: contain; }

  /* Zoom dialog */
  .zoom { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    overflow: hidden; background: var(--night-950); color: var(--white); }
  .zoom[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
  .zoom::backdrop { background: var(--night-950); }
  .zbar { display: flex; align-items: center; gap: var(--space-3); border-bottom: var(--border);
    padding: max(var(--space-3), env(safe-area-inset-top, 0px)) var(--gutter) var(--space-3); }
  .ztitle { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; font-size: var(--text-sm); }
  .zcount { font: 500 var(--text-sm)/1 var(--font-body); font-variant-numeric: tabular-nums; color: var(--smoke-400); }
  .ztools { display: flex; gap: var(--space-2); }
  .zbtn, .znav { display: grid; place-items: center; width: 44px; height: 44px; border: 0;
    border-radius: var(--radius-label); background: var(--night-900); color: var(--white); transition: color var(--dur-ui), opacity var(--dur-ui); }
  .zbtn:hover, .znav:hover { color: var(--magnesium-400); }
  .zbtn[aria-disabled='true'], .znav[aria-disabled='true'] { opacity: .35; cursor: default; color: var(--white); }
  /* scripts/product.ts scales the image and moves transform-origin with the pointer */
  .zview { position: relative; overflow: hidden; touch-action: none; user-select: none; -webkit-user-select: none; cursor: zoom-in;
    background: radial-gradient(60% 40% at 50% 100%, color-mix(in srgb, var(--magnesium-400) 12%, transparent), transparent 70%); }
  .zimg { position: absolute; inset: var(--space-4); width: calc(100% - 2 * var(--space-4)); height: calc(100% - 2 * var(--space-4)); max-width: none;
    object-fit: contain; transform-origin: center; transition: transform var(--dur-ui) var(--ease-out-expo); -webkit-user-drag: none; }
  .znav { position: absolute; z-index: 1; top: 50%; translate: 0 -50%;
    background: color-mix(in srgb, var(--night-900) 80%, transparent); }
  .znav.prev { left: var(--gutter); }
  .znav.next { right: var(--gutter); }
  .zhint { padding: var(--space-3) var(--gutter) max(var(--space-3), env(safe-area-inset-bottom, 0px)); text-align: center;
    font: 500 var(--text-xs)/1.5 var(--font-body); color: var(--smoke-400); }
</style>
