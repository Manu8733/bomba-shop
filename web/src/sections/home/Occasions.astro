---
// Liquid: sections/home-occasions.liquid (blocks: image, title, collection). Images: AI illustrations, labelled.
import { collectionByHandle, available, collectionUrl } from '../../lib/catalog';
const OCC = [
  { title: 'Aniversare', img: 'occ-aniversare', handles: ['artificii-de-tort', 'bengale-candele'], blurb: 'Artificii de tort și bengale' },
  { title: 'Revelion și Crăciun', img: 'occ-revelion', handles: ['vulcani-artificii', 'artificii-de-brad'], blurb: 'Vulcani, fântâni, artificii de brad' },
  { title: 'Nuntă', img: 'occ-nunta', handles: ['bengale-candele', 'artificii-de-tort'], blurb: 'Bengale pentru intrare, tort cu scântei', href: '/pages/spectacole', cta: 'și spectacole' },
  { title: 'Gender reveal', img: 'occ-gender-reveal', handles: ['gender-reveal', 'fumigene-colorate'], blurb: 'Fum și confetti în roz sau albastru' },
  { title: 'Petrecere', img: 'occ-petrecere', handles: ['confetti', 'produse-f1-pentru-public'], blurb: 'Confetti și divertisment F1' },
];
const tiles = OCC.map((o) => {
  const cols = o.handles.map(collectionByHandle).filter(Boolean) as NonNullable<ReturnType<typeof collectionByHandle>>[];
  const stock = new Set(cols.flatMap((c) => c.products.filter(available).map((p) => p.handle))).size;
  return { ...o, stock, href: o.href ?? collectionUrl(cols[0]?.handle ?? 'public') };
});
---
<section class="section occ" aria-labelledby="occ-h">
  <div class="container">
    <div class="section-head">
      <div class="stack"><h2 id="occ-h">Alege după ocazie</h2></div>
      <p class="muted">Imagini ilustrative</p>
    </div>
    <ul class="rail">
      {tiles.map((t, i) => (
        <li class:list={{ wide: i === 0 }} data-scrub>
          <a href={t.href} class="tile">
            <img src={`/images/fx/${t.img}-800.webp`} srcset={`/images/fx/${t.img}-800.webp 800w, /images/fx/${t.img}-1600.webp 1600w`}
              sizes="(min-width: 1024px) 30vw, 80vw" width="800" height="1067" alt="" loading="lazy" decoding="async" />
            <span class="txt">
              <span class="t">{t.title}</span>
              <span class="b">{t.blurb}</span>
              <span class="n">{t.stock ? `${t.stock} produse în stoc` : 'Vezi colecția'}{t.cta ? ` · ${t.cta}` : ''} →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .rail { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1024px) { .rail { grid-template-columns: repeat(6, minmax(0, 1fr)); } .rail li { grid-column: span 2; } .rail li.wide { grid-column: span 2; grid-row: span 2; } }
  @media (max-width: 767px) { .rail { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
    .rail li { flex: 0 0 72%; scroll-snap-align: start; } }
  .rail li { --t: .5; }
  .tile { position: relative; display: block; height: 100%; min-height: 320px; border-radius: var(--radius-card); overflow: hidden; text-decoration: none; isolation: isolate; border: var(--border); }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2;
    transform: scale(1.12) translateY(calc((var(--t) - .5) * -8%)); transition: transform var(--dur-scene) var(--ease-out-expo); }
  .tile:hover img { transform: scale(1.18) translateY(calc((var(--t) - .5) * -8%)); }
  .tile::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(7, 6, 11, .92) 0%, rgba(7, 6, 11, .2) 55%, transparent 100%); }
  .txt { position: absolute; left: 0; right: 0; bottom: 0; padding: var(--space-6); display: grid; gap: 6px; }
  .t { font: 900 clamp(1.8rem, 3vw, 2.6rem)/.95 var(--font-display); text-transform: uppercase; }
  .b { color: var(--smoke-200); font-size: var(--text-sm); }
  .n { color: var(--white); font-size: var(--text-sm); font-weight: 600; }
  .tile:hover { color: var(--white); }
</style>
